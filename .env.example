DEEPSEEK_API_KEY=replace_me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_INTERVIEW_MODEL=deepseek-v4-flash
DATABASE_URL=sqlite:///./shuyi.db

# MiniMax 媒体生成（key 由前端同学提供；留空则媒体接口报错或走 Mock）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.io
MINIMAX_IMAGE_MODEL=image-01
MINIMAX_SPEECH_MODEL=speech-2.8-hd
MINIMAX_VIDEO_MODEL=MiniMax-H3

# 存储与公开地址
MEDIA_STORAGE_DIR=./uploads
PUBLIC_BASE_URL=http://127.0.0.1:8000

# CORS：允许的前端来源，逗号分隔（开发期覆盖 Vinext/Vite 常见端口，上线前收紧为正式域名）
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173

# 开发期设为 true 以启用 /api/reset；生产环境必须设为 false
ENABLE_DESTRUCTIVE_ENDPOINTS=true

# 无 MiniMax key 时联调用：跳过真实调用，生成本地占位资源
ENABLE_MOCK_MEDIA=false
